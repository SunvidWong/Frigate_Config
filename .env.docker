# Frigate Docker 部署配置
# Phase 8 - 卷映射路径

# Frigate 配置文件路径
FRIGATE_CONFIG_PATH=/Users/sunvid/frigate/config

# 录像存储路径
FRIGATE_RECORDINGS_PATH=/Users/sunvid/frigate/recordings

# 剪辑存储路径
FRIGATE_CLIPS_PATH=/Users/sunvid/frigate/clips

# 缓存路径
FRIGATE_CACHE_PATH=/Users/sunvid/frigate/cache

# 时区
TZ=Asia/Shanghai

# RTSP 密码 (可选)
FRIGATE_RTSP_PASSWORD=password
