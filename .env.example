# Frigate Configuration Tool - Phase 8
# Environment Variables Example

# Frigate 卷映射路径 (Phase 8 配置)
# 根据您在 Config Tool 中配置的路径修改这些值

# Config 目录 - 存储 Frigate 配置文件
FRIGATE_CONFIG_PATH=~/frigate/config

# Recordings 目录 - 存储录像 (建议 100GB+)
FRIGATE_RECORDINGS_PATH=~/frigate/recordings

# Clips 目录 - 存储剪辑 (建议 20GB+)
FRIGATE_CLIPS_PATH=~/frigate/clips

# Cache 目录 - 临时缓存 (建议 10GB+)
FRIGATE_CACHE_PATH=~/frigate/cache

# Frigate 设置
FRIGATE_RTSP_PASSWORD=your_secure_password_here

# 时区设置
TZ=Asia/Shanghai

# 数据库路径 (可选)
FRIGATE_CONFIG_DB_PATH=~/.frigate-config-tool

# 日志级别
RUST_LOG=info
