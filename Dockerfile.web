# Web-only Dockerfile for Frigate Configuration Tool
# This builds and serves only the web interface without Tauri backend
# Perfect for running in Docker containers

FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY src-ui/package*.json ./src-ui/

# Install dependencies
WORKDIR /app/src-ui
RUN npm ci

# Copy source code
COPY src-ui/ ./

# Build for production
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/src-ui/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
